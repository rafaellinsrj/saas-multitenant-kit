# Local development only. Every value here is a placeholder.
# Owner role: runs migrations, owns tables. Never used by the API.
DATABASE_OWNER_URL=postgresql+asyncpg://kit_owner:kit_owner_local@localhost:54329/kit
# Application role: no ownership, no BYPASSRLS. Used by the API and the worker.
DATABASE_URL=postgresql+asyncpg://kit_app:kit_app_local@localhost:54329/kit
KIT_APP_DB_PASSWORD=kit_app_local

# HMAC key for the demo bearer tokens (replace with your identity provider).
TOKEN_SECRET=change-me-local-token-secret

# Vault keyring: {"key-id": "<base64 of 32 random bytes>"}. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}
VAULT_ACTIVE_KEY=k1

# Webhook signing secret configured in the payment provider dashboard.
PAYMENT_WEBHOOK_SECRET=replace-me
